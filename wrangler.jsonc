{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "image-host",
	"main": "src/index.ts",
	"compatibility_date": "2026-05-22",
	"d1_databases": [
		{
			"binding": "image_host_db",
			"database_name": "image-host-db",
			"database_id": "9e8659f8-521b-4786-a15c-e81d1ba8ab0c"
		}
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "images"
		}
	],
	"triggers": {
		"crons": [
			"0 * * * *"
		]
	}
